# Cloudflare static asset headers. Rules that match the same request are merged
# (same-name headers get comma-joined), so Cache-Control is only set on /badges/*.
# Everything else keeps Cloudflare's default: revalidate with ETag on every request.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: default-src 'none'; img-src 'self' data:; style-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'

# Badge files are named by content hash, so a URL never changes content.
/badges/*
  Cache-Control: public, max-age=31536000, immutable
